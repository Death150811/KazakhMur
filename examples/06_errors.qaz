# title: Қателерді өңдеу
функ бөлу(a, b):
    егер b == 0:
        лақтыр "нөлге бөлуге болмайды".
    қайтар a / b.

әрбір b ішінде [4, 0, 8]:
    байқа:
        жаз(ф"100 / {b} = {бөлу(100, b)}").
    қате е:
        жаз("Қате:", е).
    соңында:
        жаз("--").

байқа:
    айным тізім2 = [1, 2, 3].
    жаз(тізім2[10]).
қате е:
    жаз(е).

байқа:
    жаз("сан" + 5).
қате е:
    жаз(е).
