# title: Функциялар және рекурсия
функ факториал(n):
    егер n <= 1:
        қайтар 1.
    қайтар n * факториал(n - 1).

функ фибоначчи(n):
    егер n < 2:
        қайтар n.
    қайтар фибоначчи(n - 1) + фибоначчи(n - 2).

функ сәлемдесу(есім, қосымша = "Қош келдіңіз!"):
    қайтар есім + ": " + қосымша.

жаз(факториал(10)).
жаз(факториал(25)).
жаз(бейнеле(фибоначчи, аралық(12))).
жаз(сәлемдесу("Айгүл")).
жаз(сәлемдесу("Нұрлан", "Сәлем!")).

# Тұйықталу (closure)
функ санауыш():
    айным c = 0.
    функ келесі():
        c += 1.
        қайтар c.
    қайтар келесі.

айным а = санауыш().
жаз(а(), а(), а()).
