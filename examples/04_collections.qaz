# title: Тізімдер мен сөздіктер
айным сандар = [5, 2, 9, 1, 7].
жаз("Сұрыпталған:", сұрып(сандар)).
жаз("Кері:", сұрып(сандар, ақиқат)).
жаз("Ұзындығы:", ұзындық(сандар), "Қосындысы:", қосынды(сандар)).
жаз("Үлкені:", максимум(сандар), "Кішісі:", минимум(сандар)).
жаз("Кесінді:", сандар[1:4], сандар[::-1]).

функ жұп(x):
    қайтар x % 2 == 0.
жаз(сүз(жұп, аралық(10))).

сандар.қос(100).
жаз(сандар).

айным қала = {"Астана": 1350000, "Алматы": 2000000}.
қала["Шымкент"] = 1200000.
әрбір атауы, халқы ішінде қала.жұптар():
    жаз(ф"{атауы}: {халқы}").

жаз("Астана" ішінде қала, "Орал" ішінде қала).
жаз("Қалалар:", ", ".біріктір(қала.кілттер())).
жаз("Сәлем, Әлем!".жоғары(), "қазақ тілі".бөл(" ")).
