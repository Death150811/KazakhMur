# title: Сыныптар
сынып Жануар:
    функ жасау(өзі, аты):
        өзі.аты = аты.
    функ дыбыс(өзі):
        қайтар "...".
    функ сөйле(өзі):
        жаз(өзі.аты + ":", өзі.дыбыс()).

сынып Ит(Жануар):
    функ дыбыс(өзі):
        қайтар "Әу-әу!".

сынып Мысық(Жануар):
    функ дыбыс(өзі):
        қайтар "Мияу!".

әрбір жан ішінде [Ит("Тарзан"), Мысық("Мурка"), Жануар("Белгісіз")]:
    жан.сөйле().

сынып Шот:
    функ жасау(өзі, баланс = 0):
        өзі.баланс = баланс.
    функ салу(өзі, сома):
        өзі.баланс += сома.
    функ алу(өзі, сома):
        егер сома > өзі.баланс:
            лақтыр "Қаражат жеткіліксіз".
        өзі.баланс -= сома.

айным шот = Шот(1000).
шот.салу(500).
шот.алу(300).
жаз("Баланс:", шот.баланс).
байқа:
    шот.алу(5000).
қате е:
    жаз("Қате:", е).
