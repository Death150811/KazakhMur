# title: Шарттар мен циклдер
функ баға(ұпай):
    егер ұпай >= 90:
        қайтар "өте жақсы".
    әйтпесе егер ұпай >= 70:
        қайтар "жақсы".
    әйтпесе егер ұпай >= 50:
        қайтар "қанағат".
    әйтпесе:
        қайтар "нашар".

әрбір ұпай ішінде [95, 72, 55, 30]:
    жаз(ұпай, "->", баға(ұпай)).

# әзір циклі, тоқта және жалғас
айным n = 0.
әзір ақиқат:
    n += 1.
    егер n % 2 == 0:
        жалғас.
    егер n > 7:
        тоқта.
    жаз("тақ сан:", n).

# FizzBuzz
әрбір i ішінде аралық(1, 16):
    егер i % 15 == 0:
        жаз("FizzBuzz").
    әйтпесе егер i % 3 == 0:
        жаз("Fizz").
    әйтпесе егер i % 5 == 0:
        жаз("Buzz").
    әйтпесе:
        жаз(i).
