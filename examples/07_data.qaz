# title: Деректерді талдау және болжау
айным өлшем = [12.5, 14.1, 13.8, 15.2, 16.0, 14.7].
айным нәтиже = талда(өлшем).
жаз("Саны:", нәтиже["саны"]).
жаз("Орташа:", дөңгелекте(нәтиже["орташа"], 3)).
жаз("Медиана:", дөңгелекте(нәтиже["медиана"], 3)).
жаз("Ауытқу:", дөңгелекте(нәтиже["ауытқу"], 3)).

# Қарапайым сызықтық регрессия: y = k·x + b
айным сағат = [1, 2, 3, 4, 5].
айным ұпай = [52, 58, 65, 71, 77].
айным үлгі = үйрет(сағат, ұпай).
жаз("Көлбеу:", дөңгелекте(үлгі["көлбеу"], 2), "Жылжу:", дөңгелекте(үлгі["жылжу"], 2)).
жаз("R2:", дөңгелекте(үлгі["R2"], 4)).
жаз("6 сағат үшін болжам:", дөңгелекте(болжа(үлгі, 6), 1)).
