# title: Жай сандар
функ жай_ма(n):
    егер n < 2:
        қайтар жалған.
    айным d = 2.
    әзір d * d <= n:
        егер n % d == 0:
            қайтар жалған.
        d += 1.
    қайтар ақиқат.

айным жайлар = сүз(жай_ма, аралық(2, 60)).
жаз(жайлар).
жаз("Саны:", ұзындық(жайлар)).

# Эратосфен елегі
функ елек(шек):
    айным бар = [ақиқат] * (шек + 1).
    бар[0] = жалған.
    бар[1] = жалған.
    әрбір i ішінде аралық(2, шек + 1):
        егер бар[i] және i * i <= шек:
            айным j = i * i.
            әзір j <= шек:
                бар[j] = жалған.
                j += i.
    айным нәтиже = [].
    әрбір i ішінде аралық(шек + 1):
        егер бар[i]:
            нәтиже.қос(i).
    қайтар нәтиже.

жаз(елек(60) == жайлар).
жаз(ұзындық(елек(10000))).
